# ---- Banco de dados (Docker / MySQL 8) ----
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=ecoviagem
MYSQL_PORT=3306

# ---- Conexão usada pela API (usuário de aplicação com menor privilégio) ----
# Em desenvolvimento pode usar o root; em produção use app_api.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecoviagem
DB_USER=app_api
DB_PASSWORD=app_api_senha

# ---- API ----
PORT=8080

# ---- Site (frontend) ----
# Porta pública onde o site é servido. Em desenvolvimento, 5173.
# Em produção (VPS), use 80 (HTTP) — e 443 se configurar HTTPS.
WEB_PORT=5173

# ---- URL da API (só para frontend hospedado separado, ex.: Vercel) ----
# Em Docker/VPS deixe VAZIO (o nginx faz proxy de /api). Na Vercel, defina com a
# URL pública do backend + /api, ex.: https://api.seu-host.com/api
VITE_API_URL=

# ---- Google Maps ----
# Chave do Google Cloud (com billing ativo) para traçar rotas REAIS na página
# "Planejar Rota" (carro, transporte público, bicicleta e a pé). Ative no console:
#   Maps JavaScript API · Places API · Directions API
# e restrinja a chave por "HTTP referrer" (ex.: http://localhost:5173/*).
# Sem chave, o app usa OpenStreetMap/OSRM e oferece o link "abrir no Google Maps".
# Após preencher, rebuilde o frontend: docker compose --profile full up --build -d web
VITE_GOOGLE_MAPS_API_KEY=

# ---- E-mail (2FA e recuperação de senha) ----
# Deixe MAIL_ENABLED=false para modo demonstração (o código aparece na tela).
# Para enviar e-mails de verdade, use um SMTP (ex.: Gmail com senha de app):
#   MAIL_ENABLED=true
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=seu-email@gmail.com
#   MAIL_PASSWORD=sua-senha-de-app
#   MAIL_FROM=EcoViagem <seu-email@gmail.com>
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=EcoViagem <no-reply@ecoviagem.local>
