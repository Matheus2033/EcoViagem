# ---- Banco de dados (Docker / MySQL 8) ----
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=ecoviagem
MYSQL_PORT=3306

# ---- Conexão usada pela API (usuário de aplicação com menor privilégio) ----
# Em desenvolvimento pode usar o root; em produção use app_api.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecoviagem
DB_USER=app_api
DB_PASSWORD=app_api_senha

# ---- API ----
PORT=8080

# ---- Site (frontend) ----
# Porta pública onde o site é servido. Em desenvolvimento, 5173.
# Em produção (VPS), use 80 (HTTP) — e 443 se configurar HTTPS.
WEB_PORT=5173

# ---- Google Maps (opcional) ----
# Chave da API do Google Maps JavaScript (com billing ativo) para traçar rotas
# reais na página "Planejar Rota". Deixe vazio para usar distância em linha reta.
# Após preencher, rebuilde o frontend: docker compose --profile full up --build -d web
VITE_GOOGLE_MAPS_API_KEY=

# ---- E-mail (2FA e recuperação de senha) ----
# Deixe MAIL_ENABLED=false para modo demonstração (o código aparece na tela).
# Para enviar e-mails de verdade, use um SMTP (ex.: Gmail com senha de app):
#   MAIL_ENABLED=true
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=seu-email@gmail.com
#   MAIL_PASSWORD=sua-senha-de-app
#   MAIL_FROM=EcoViagem <seu-email@gmail.com>
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=EcoViagem <no-reply@ecoviagem.local>
